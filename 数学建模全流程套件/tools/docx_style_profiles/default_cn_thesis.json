{
  "profile_name": "中文学术论文默认样式",
  "page": {
    "size": "A4",
    "margin_top_cm": 2.5,
    "margin_bottom_cm": 2.5,
    "margin_left_cm": 2.5,
    "margin_right_cm": 2.5
  },
  "fonts": {
