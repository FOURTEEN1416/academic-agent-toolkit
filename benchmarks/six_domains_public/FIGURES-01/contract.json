  "pass_rule": "全部检查为 true",
  "four_dimensions": {
    "quality": "evaluate.py 全检查通过 + 几何/字节/溯源一致性",
    "reliability": "门禁拒绝→修复→通过闭环可追溯",
    "efficiency": "workflow events 时间戳（start→completed）",
    "cost": "外部 API 调用次数与费用（本基准应可为 0）"
  }
}
