{
  "benchmark_id": "comp-literature-p0",
  "capability": "comp-literature",
  "domain": "math_modeling_competition",
  "name": "文献调研验收基准",
  "description": "预置检索结果（2 条真实论文），验收文献调研的引用真实性与证据记录完整性",
  "fixtures": {
    "input": ["fixtures/preset_search_results.json"],
    "expected_output": ["LITERATURE.md", "literature/search_evidence.json", "paper/references.bib"]
