    "search_evidence_json": {"required": true},
    "bib_exists": {"required": true},
    "bib_key_overlap": {"min": 2, "description": "references.bib 的 citation key 必须与 search_evidence 的 key 有交集"},
    "no_invented_references": {"required": true, "description": "search_evidence 记录的必须是 preset 中的论文"},
    "min_size_bytes": 1000
  },
  "scoring_script": "evaluate.py",
  "status": "experimental"
}