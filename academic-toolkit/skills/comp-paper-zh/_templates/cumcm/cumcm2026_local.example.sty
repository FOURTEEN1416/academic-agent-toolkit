%% cumcm2026_local.example.sty —— 继承式工程定制模板（D5 双源分叉修复，2026-09-13）
%% ═══════════════════════════════════════════════════════════════════════════
%% 背景：整份复制 cumcm2026.sty 再私改 = 双源分叉（diff 说不清改了什么，
%% 合规审查无法对账，见 2026-09-12 原仓库缺陷 D5）。继承式 = 真源单一 +
%% 差异自文档化：local 文件与真源的 diff 就是本队全部定制。
%%
%% 用法：
%%   1. 复制本文件为 cumcm2026_local.sty 放进你的 paper/；
%%   2. 改下面的 BASELINE 行，登记所继承的真源版本；
%%   3. 只在 PATCH 区写与真源的差异，每条附理由；
%%   4. main.tex 里 \usepackage{cumcm2026_local} 替代 \usepackage{cumcm2026}。
%% ═══════════════════════════════════════════════════════════════════════════
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{cumcm2026_local}[2026/09/13 v0.1 CUMCM 2026 inherited local overrides]

%% BASELINE: cumcm2026.sty v1.0 (2026/08/23)
%% 真源位置：academic-toolkit/skills/comp-paper-zh/_templates/cumcm/cumcm2026.sty
%% （升级基线时：读真源 TEMPLATE_VERSION 块，diff 新旧真源，核对 PATCH 区仍适用）

%% 继承真源（本文件与 cumcm2026.sty 同目录时直接 \input；否则调整路径）：
\input{cumcm2026}

