% csf.sty — 全国大学生仿真建模应用挑战赛（CSF）论文样式补丁
% =====================================================================
% 用途：把 CSF 当届可确证与待确证的版式要求集中到一处，便于《论文规范》
%       正式件到位后**单点回填**（改本文件 + comp_rules + csf-official-format.md）。
%
% 已确证（真源 skills/comp-paper-zh/references/csf-official-format.md）：
%   - 论文为单一 PDF；摘要必须在论文文件第一页且不得拆分；
%   - 源程序作为附录放正文之后、与正文同一个文件；
%   - 任何页面不得出现姓名/学校等身份信息（匿名评审）。
%
% 未确证（禁止臆测；本文件按**模板默认保守值**，非官方主张）：
%   - 页数上限、页边距、字体字号、行距、页眉页脚、页码、摘要页要素、
%     参考文献体例、是否要求目录页。
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{csf}[2026/10/16 v0.1 CSF submission constraints (格式缺口待官方《论文规范》回填)]

% 版式保守默认（非官方条款）：A4 四边 2.5cm，页脚居中页码，无页眉身份信息。
\RequirePackage[a4paper,top=2.5cm,bottom=2.5cm,left=2.5cm,right=2.5cm]{geometry}
\RequirePackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[C]{\zihao{5}\songti 仿真建模应用挑战赛论文}   % 中性标题，不含任何身份信息
\fancyfoot[C]{\thepage}

% 匿名红线提示：正文中不得出现姓名/学校/邮箱等身份标识。
% （本注释是给写手的硬提醒，不是可执行约束——身份扫描由作者与提交校验器共同把关。）

% 参考文献体例未确证 → 保持文档类默认，不作官方主张。
\endinput
