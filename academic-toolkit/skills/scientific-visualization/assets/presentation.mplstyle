# Presentation/Poster style — academic.mplstyle 的演示差异档
# ==================================================================
# 基线真源：academic-toolkit/skills/_utils/academic.mplstyle
# 本文件 = 基线 + 下列差异项，可独立 plt.style.use：
#   差异项：字号 14-18pt（投影/海报可视距离）、figsize 8x6、线宽加粗。
#   仅用于演示交付物；论文/竞赛正图禁用本档。
#   其余键（CJK 字体链/定版色板/bbox=standard 护栏）与基线同值。
# ==================================================================

# Figure properties
figure.dpi: 100
figure.facecolor: white
figure.constrained_layout.use: True
figure.figsize: 8, 6

# Font properties (larger for visibility)
font.size: 14
font.family: sans-serif
font.sans-serif: Noto Sans SC, NotoSansSC, SimHei, Microsoft YaHei, PingFang SC, Arial, Helvetica, DejaVu Sans
axes.unicode_minus: False

# Axes properties
axes.linewidth: 1.5
axes.labelsize: 16
axes.titlesize: 18
axes.labelweight: normal
axes.spines.top: False
axes.spines.right: False
axes.edgecolor: black
axes.axisbelow: True
axes.grid: False
# 定版色板与基线一致（低饱和 elegant 8 色；理由见 academic.mplstyle 文件头。
# 高可及性备选 Okabe-Ito 见 assets/color_palettes.py；禁 tab10 默认色环）
axes.prop_cycle: cycler('color', ['7AAEC8', 'E8945A', '7BC8A4', '9B8EC4', 'E0A0A0', 'F0C05A', '8FAEC0', 'A8C4D8'])

# Tick properties
xtick.major.size: 6
xtick.minor.size: 4
xtick.major.width: 1.5
xtick.minor.width: 1.0
xtick.labelsize: 12
xtick.direction: out
ytick.major.size: 6
ytick.minor.size: 4
ytick.major.width: 1.5
ytick.minor.width: 1.0
ytick.labelsize: 12
ytick.direction: out

# Line properties
lines.linewidth: 2.5
lines.markersize: 8
lines.markeredgewidth: 1.0

# Legend properties
legend.fontsize: 12
legend.frameon: False

# Save properties
savefig.dpi: 300
savefig.format: png
savefig.bbox: standard
savefig.pad_inches: 0.1
savefig.facecolor: white

# Image properties
image.cmap: viridis
