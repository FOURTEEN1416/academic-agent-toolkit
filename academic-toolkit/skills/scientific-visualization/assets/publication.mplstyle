# Publication journal style — academic.mplstyle 的期刊印刷差异档
# ==================================================================
# 基线真源：academic-toolkit/skills/_utils/academic.mplstyle
# （字号阶梯/CJK 字体链/定版色板/保存护栏的理由都在基线文件头）。
# 本文件 = 基线 + 下列差异项，可独立 plt.style.use：
#   差异项（相对基线）：
#   · 字号阶梯 8/9/7pt（期刊印刷尺度，基线为 A4 屏幕口径 11/12/13/10）
#   · figsize 3.5x2.5（Nature 单栏 89mm 量级）、figure.dpi 100（屏幕预览）
#   · constrained_layout True（期刊小图自动排版）
#   · lines/legend 更细更小（印刷小图密度）
#   其余键与基线同值（savefig.bbox=standard 护栏、CJK 字体链、定版色板）。
#   含中文标签的图：保留下面 font.sans-serif 的 CJK 链，勿删成纯拉丁链。
# ==================================================================

# Figure properties
figure.dpi: 100
figure.facecolor: white
figure.autolayout: False
figure.constrained_layout.use: True
figure.figsize: 3.5, 2.5

# Font properties（含 CJK 链，纯英文图可按 SKILL 差异项收窄）
font.size: 8
font.family: sans-serif
font.sans-serif: Noto Sans SC, NotoSansSC, SimHei, Microsoft YaHei, PingFang SC, Arial, Helvetica, DejaVu Sans
axes.unicode_minus: False
mathtext.fontset: stix

# Axes properties
axes.linewidth: 0.5
axes.labelsize: 9
axes.titlesize: 9
axes.labelweight: normal
axes.spines.top: False
axes.spines.right: False
axes.spines.left: True
axes.spines.bottom: True
axes.edgecolor: black
axes.labelcolor: black
axes.axisbelow: True
axes.grid: False
# 定版色板与基线一致（低饱和 elegant 8 色；理由见 academic.mplstyle 文件头。
# 高可及性备选 Okabe-Ito 见 assets/color_palettes.py；禁 tab10 默认色环）
axes.prop_cycle: cycler('color', ['7AAEC8', 'E8945A', '7BC8A4', '9B8EC4', 'E0A0A0', 'F0C05A', '8FAEC0', 'A8C4D8'])

# Tick properties
xtick.major.size: 3
xtick.minor.size: 2
xtick.major.width: 0.5
xtick.minor.width: 0.5
xtick.labelsize: 7
xtick.direction: out
ytick.major.size: 3
ytick.minor.size: 2
ytick.major.width: 0.5
ytick.minor.width: 0.5
ytick.labelsize: 7
ytick.direction: out

# Line properties
lines.linewidth: 1.5
lines.markersize: 4
lines.markeredgewidth: 0.5

# Legend properties
legend.fontsize: 7
legend.frameon: False
legend.loc: best

# Save properties（bbox=standard 护栏与基线一致：禁 tight，防 mediabox 撑爆）
savefig.dpi: 300
savefig.format: pdf
savefig.bbox: standard
savefig.pad_inches: 0.05
savefig.transparent: False
savefig.facecolor: white

# Image properties
image.cmap: viridis
image.aspect: auto
