# 科研系统 API 配置模板
# 复制本文件为 .env 并填入真实密钥；.env 含敏感信息，不要提交到 Git

# ============================================
# Agnes AI（免费全模态，主力）
# 文本：agnes-2.5-flash（512K 上下文，免费最优）
# 视觉：agnes-2.5-flash（支持 image_url 输入，视觉工具/视觉智能体统一使用）
# 图像：agnes-image-2.1-flash（4K 输出，免费最优）
# ============================================
AGNES_API_KEY=<REPLACE_ME>
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.5-flash
AGNES_VISION_MODEL=agnes-2.5-flash
AGNES_IMAGE_MODEL=agnes-image-2.1-flash

# ============================================
# 商汤 SenseNova（备胎文本，OpenCode 主模型来源）
# ⚠️ 注意：GLM-5.2 限速严重不可用；数模相关 agent 已改用 deepseek / opencode zen / agnes
# ============================================
SENSENOVA_API_KEY=<REPLACE_ME>
SENSENOVA_BASE_URL=https://token.sensenova.cn/v1
SENSENOVA_MODEL=deepseek-v4-flash

# ============================================
# 系统工具映射（供 quality_gates.py / 各 skill 使用）
# 默认全部复用 Agnes 同一密钥；按需替换为独立密钥
# ============================================

# 视觉审查（EDITOR_AI_*）→ Agnes agnes-2.5-flash（支持图像输入，免费）
EDITOR_AI_API_KEY=<REPLACE_ME>
EDITOR_AI_BASE_URL=https://apihub.agnes-ai.com/v1
EDITOR_AI_MODEL_ID=agnes-2.5-flash

# 审稿人（reviewer_client.py 用的 OPENAI_*）→ Agnes agnes-2.5-flash（免费文本最优）
OPENAI_API_KEY=<REPLACE_ME>
OPENAI_BASE_URL=https://apihub.agnes-ai.com/v1
REVIEWER_MODEL_ID=agnes-2.5-flash

# 图像生成（gpt_image.py 用的 GPT_IMAGE_*）→ Agnes agnes-image-2.1-flash（4K 免费）
GPT_IMAGE_API_KEY=<REPLACE_ME>
GPT_IMAGE_BASE_URL=https://apihub.agnes-ai.com/v1
GPT_IMAGE_MODEL=agnes-image-2.1-flash
